{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "YarpUi": {
    "Auth": {
      "Username": "admin",
      "Password": "embedded-demo"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "sample-route": {
        "ClusterId": "sample-cluster",
        "Order": 1,
        "Match": {
          "Path": "/sample/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/sample" }
        ]
      }
    },
    "Clusters": {
      "sample-cluster": {
        "Destinations": {
          "example": {
            "Address": "https://example.com/"
          }
        }
      }
    }
  }
}
