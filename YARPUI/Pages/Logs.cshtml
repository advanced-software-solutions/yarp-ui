@page
@model YARPUI.Pages.LogsModel
@{
    ViewData["Title"] = L["logs.title"];
    ViewData["BodyId"] = "logs";
}
<div class="logs-page">
    <div class="logs-toolbar">
        <div class="search-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                <circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" />
            </svg>
            <input id="log-search" type="search" placeholder="@L["logs.searchPlaceholder"]" autocomplete="off" spellcheck="false" />
        </div>
        <select id="log-status" class="select" title="@L["logs.filterStatusTitle"]">
            <option value="">@L["logs.allStatuses"]</option>
            <option value="2">@L["logs.status2"]</option>
            <option value="3">@L["logs.status3"]</option>
            <option value="4">@L["logs.status4"]</option>
            <option value="5">@L["logs.status5"]</option>
        </select>
        <label class="toggle" title="@L["logs.liveTitle"]">
            <input type="checkbox" id="log-auto" checked />
            <span class="toggle-track"><span class="toggle-dot"></span></span>
            <span class="toggle-label">@L["logs.live"] <span class="live-dot" id="live-dot"></span></span>
        </label>
        <select id="log-retention" class="select" title="@L["logs.retentionTitle"]">
            <option value="0">@L["logs.keepForever"]</option>
            <option value="1">@L["logs.keepOneDay"]</option>
            <option value="7">@string.Format(L["logs.keepDays"], 7)</option>
            <option value="30">@string.Format(L["logs.keepDays"], 30)</option>
            <option value="90">@string.Format(L["logs.keepDays"], 90)</option>
            <option value="365">@L["logs.keepOneYear"]</option>
        </select>
        <span class="toolbar-spacer"></span>
        <span id="log-count" class="muted small"></span>
        <button type="button" id="log-clear" class="btn btn-ghost" title="@L["logs.clearTitle"]">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 7h16" /><path d="M10 11v6M14 11v6" /><path d="M6 7l1 13h10l1-13" /><path d="M9 7V4h6v3" />
            </svg>
            @L["logs.clear"]
        </button>
    </div>
    <div class="logs-filters">
        <select id="log-route" class="select select-sm" title="@L["logs.filterRouteTitle"]">
            <option value="">@L["logs.allRoutes"]</option>
        </select>
        <select id="log-cluster" class="select select-sm" title="@L["logs.filterClusterTitle"]">
            <option value="">@L["logs.allClusters"]</option>
        </select>
        <select id="log-destination" class="select select-sm" title="@L["logs.filterDestinationTitle"]">
            <option value="">@L["logs.allDestinations"]</option>
        </select>
        <select id="log-range" class="select select-sm" title="@L["logs.rangeTitle"]">
            <option value="">@L["logs.rangeLive"]</option>
            <option value="15">@L["logs.last15"]</option>
            <option value="60">@L["logs.lastHour"]</option>
            <option value="360">@L["logs.last6h"]</option>
            <option value="1440">@L["logs.last24h"]</option>
            <option value="10080">@L["logs.last7d"]</option>
            <option value="custom">@L["logs.rangeCustom"]</option>
            <option value="all">@L["logs.rangeAll"]</option>
        </select>
        <input id="log-from" type="datetime-local" class="input input-sm hidden" title="@L["logs.fromTitle"]" aria-label="@L["logs.fromLabel"]" />
        <input id="log-to" type="datetime-local" class="input input-sm hidden" title="@L["logs.toTitle"]" aria-label="@L["logs.toLabel"]" />
        <button type="button" id="log-reset" class="btn btn-ghost btn-sm hidden" title="@L["logs.resetTitle"]">@L["logs.reset"]</button>
    </div>
    <section class="charts-panel" id="charts-panel">
        <div class="charts-header">
            <button type="button" id="charts-toggle" class="charts-toggle" title="@L["logs.performanceTitle"]">
                <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9l6 6 6-6" />
                </svg>
                @L["logs.performance"]
            </button>
            <span class="muted small" id="stats-caption"></span>
            <span class="toolbar-spacer"></span>
            <label class="muted small" for="stats-window">@L["logs.window"]</label>
            <select id="stats-window" class="select select-sm">
                <option value="5">@L["logs.last5"]</option>
                <option value="15" selected>@L["logs.last15"]</option>
                <option value="60">@L["logs.lastHour"]</option>
                <option value="1440">@L["logs.last24h"]</option>
                <option value="0">@L["logs.rangeAll"]</option>
            </select>
        </div>
        <div class="charts-body" id="charts-body">
            <div class="stat-cards">
                <div class="stat-card"><span class="stat-label">@L["logs.statRequests"]</span><span class="stat-value" id="stat-count">—</span></div>
                <div class="stat-card"><span class="stat-label">@L["logs.statAvg"]</span><span class="stat-value" id="stat-avg">—</span></div>
                <div class="stat-card"><span class="stat-label">@L["logs.statP95"]</span><span class="stat-value" id="stat-p95">—</span></div>
                <div class="stat-card"><span class="stat-label">@L["logs.statMax"]</span><span class="stat-value" id="stat-max">—</span></div>
                <div class="stat-card"><span class="stat-label">@L["logs.statErrorRate"]</span><span class="stat-value" id="stat-errors">—</span></div>
            </div>
            <div class="charts-main">
                <div class="chart-wrap">
                    <div class="chart-title muted small">@L["logs.chartTitle"]</div>
                    <div class="chart-canvas"><canvas id="logs-chart"></canvas></div>
                </div>
                <div class="route-bars">
                    <div class="chart-title muted small">@L["logs.slowestRoutes"]</div>
                    <div id="route-bars-list" class="route-bars-list"><div class="muted small route-bars-empty">@L["logs.noRequestsYet"]</div></div>
                </div>
            </div>
        </div>
    </section>
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th class="col-time th-sortable" data-sort="timestamp" aria-sort="descending">@L["logs.colTime"]</th>
                    <th class="col-method th-sortable" data-sort="method">@L["logs.colMethod"]</th>
                    <th class="th-sortable" data-sort="path">@L["logs.colPath"]</th>
                    <th class="col-status th-sortable" data-sort="status">@L["logs.colStatus"]</th>
                    <th class="col-duration th-sortable" data-sort="duration">@L["logs.colDuration"]</th>
                    <th class="th-sortable" data-sort="clientIp">@L["logs.colClientIp"]</th>
                    <th class="th-sortable" data-sort="route">@L["logs.colRoute"]</th>
                    <th class="th-sortable" data-sort="cluster">@L["logs.colCluster"]</th>
                    <th class="th-sortable" data-sort="destination">@L["logs.colDestination"]</th>
                </tr>
            </thead>
            <tbody id="log-rows"></tbody>
        </table>
        <div id="log-empty" class="empty-inline hidden">
            <span id="log-empty-live">@L["logs.emptyLive"]</span>
            <span class="muted small" id="log-empty-hint">@L["logs.emptyHint"]</span>
            <span id="log-empty-filtered" class="hidden">@L["logs.emptyFiltered"]</span>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/_content/YARPUI/lib/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/_content/YARPUI/js/logs.js" asp-append-version="true"></script>
}
