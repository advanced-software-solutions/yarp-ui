@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.Localization
@{
    // Current UI culture for the page shell (lang/dir) plus every localized string the
    // first-party scripts need — they have no build step, so the server serializes the
    // current culture's dictionary (with parent-culture fallback) into window.YarpUi.
    var uiCulture = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture.UICulture ?? CultureInfo.CurrentUICulture;
    var direction = uiCulture.TextInfo.IsRightToLeft ? "rtl" : "ltr";
    var strings = L.GetAllStrings(includeParentCultures: true).ToDictionary(s => s.Name, s => s.Value);
}
<script>
    window.YarpUi = window.YarpUi || {};
    window.YarpUi.culture = @Html.Raw(JsonSerializer.Serialize(new { name = uiCulture.Name, dir = direction }));
    window.YarpUi.strings = @Html.Raw(JsonSerializer.Serialize(strings));
</script>
