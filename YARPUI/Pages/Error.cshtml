@page
@model YARPUI.Pages.ErrorModel
@{
    ViewData["Title"] = "Error — YARP UI";
}
<div class="panel center-panel">
    <h1 class="panel-title">Something went wrong</h1>
    <p class="muted">An error occurred while processing your request.</p>
    @if (Model.ShowRequestId)
    {
        <p class="mono small"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
</div>
