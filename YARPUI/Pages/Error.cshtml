@page
@model YARPUI.Pages.ErrorModel
@{
    ViewData["Title"] = L["error.title"];
}
<div class="panel center-panel">
    <h1 class="panel-title">@L["error.heading"]</h1>
    <p class="muted">@L["error.body"]</p>
    @if (Model.ShowRequestId)
    {
        <p class="mono small"><strong>@L["error.requestId"]</strong> <code>@Model.RequestId</code></p>
    }
</div>
