@page
@model YARPUI.Pages.EditorModel
@{
    ViewData["Title"] = L["editor.title"];
    ViewData["BodyId"] = "editor";
}
<div class="editor-page">
    <div class="editor-toolbar">
        <h1 class="toolbar-title">@L["editor.heading"]</h1>
        <span id="source-pill" class="pill" title=""></span>
        <span class="toolbar-spacer"></span>
        <span id="dirty-indicator" class="dirty hidden"><span class="dirty-dot"></span>@L["editor.unsavedChanges"]</span>
        <button type="button" id="btn-reload" class="btn btn-ghost" title="@L["editor.reloadTitle"]">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12a9 9 0 1 1-2.64-6.36" /><path d="M21 3v6h-6" />
            </svg>
            @L["editor.reload"]
        </button>
        <button type="button" id="btn-save" class="btn btn-primary" disabled title="@L["editor.saveTitle"]">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 4h11l3 3v13H5z" /><path d="M8 4v5h7V4" /><path d="M8 20v-6h8v6" />
            </svg>
            @L["editor.save"]
        </button>
    </div>
    <div id="server-errors" class="error-panel hidden" role="alert"></div>
    <div class="editor-body">
        <aside class="editor-list">
            <div class="list-section">
                <div class="list-head">
                    <span class="list-title">@L["editor.routes"]</span>
                    <span class="chip chip-route" id="count-routes">0</span>
                    <span class="toolbar-spacer"></span>
                    <button type="button" id="add-route" class="btn btn-ghost btn-icon" title="@L["editor.addRoute"]">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                    </button>
                </div>
                <ul id="route-list" class="item-list"></ul>
            </div>
            <div class="list-section">
                <div class="list-head">
                    <span class="list-title">@L["editor.clusters"]</span>
                    <span class="chip chip-cluster" id="count-clusters">0</span>
                    <span class="toolbar-spacer"></span>
                    <button type="button" id="add-cluster" class="btn btn-ghost btn-icon" title="@L["editor.addCluster"]">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                    </button>
                </div>
                <ul id="cluster-list" class="item-list"></ul>
            </div>
            <div class="list-foot">
                <button type="button" id="btn-reset" class="btn btn-danger-ghost btn-sm" title="@L["editor.resetTitle"]">
                    @L["editor.resetToAppsettings"]
                </button>
            </div>
        </aside>
        <section class="editor-main" id="editor-main">
            <div class="editor-placeholder">
                <div class="empty-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 20h4L19 9a2.5 2.5 0 0 0-3.5-3.5L4.5 16.5z" />
                    </svg>
                </div>
                <h2>@L["editor.nothingSelected"]</h2>
                <p class="muted">@L["editor.pickItem"]</p>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/_content/YARPUI/js/editor.js" asp-append-version="true"></script>
}
