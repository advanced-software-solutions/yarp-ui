{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "YarpUi": {
    "Auth": {
      "Username": "admin",
      "Password": "yarp-admin"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "echo-get-route": {
        "ClusterId": "echo-cluster",
        "Order": 1,
        "Match": {
          "Path": "/echo/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/echo" }
        ]
      },
      "echo-post-route": {
        "ClusterId": "echo-cluster",
        "Order": 2,
        "Match": {
          "Path": "/echo-post/{**catch-all}",
          "Methods": [ "POST", "PUT", "PATCH" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/echo-post" }
        ]
      },
      "docs-route": {
        "ClusterId": "docs-cluster",
        "Order": 3,
        "Match": {
          "Path": "/docs/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/docs" }
        ]
      }
    },
    "Clusters": {
      "echo-cluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": {
          "postman-echo": {
            "Address": "https://postman-echo.com/"
          }
        }
      },
      "docs-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "example": {
            "Address": "https://example.com/"
          },
          "iana": {
            "Address": "https://www.iana.org/"
          }
        }
      }
    }
  }
}
